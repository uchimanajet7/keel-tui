{"abstract":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"TerminalScrollState"},{"text":" for one-dimensional range and movement calculations, and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"TerminalScrollbar"},{"text":" for a vertical indicator and its reserved column. The same","type":"text"},{"text":" ","type":"text"},{"text":"normalized state drives content slicing, movement, and the indicator. Input routing,","type":"text"},{"text":" ","type":"text"},{"text":"focus, selection, and following newly appended content remain application policies.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/keeltui\/scrolling"]}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/KeelTUI\/documentation\/KeelTUI\/Scrolling"},"hierarchy":{"paths":[["doc:\/\/KeelTUI\/documentation\/KeelTUI"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"seeAlsoSections":[{"anchor":"Terminal-primitives","identifiers":["doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalScrollState","doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalScrollMovement","doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalScrollLayout","doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalScrollbar","doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalScrollbarStyle","doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalScrollbarGeometry","doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalScrollbarVisibility","doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalScrollbarGutter","doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalTextViewport","doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalTextViewportLayout","doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalSelectableList","doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalTable","doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalCanvas","doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalDisplayWidth","doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalStatusBar"],"generated":true,"title":"Terminal primitives"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Units and ownership","type":"heading","anchor":"Units-and-ownership","level":2},{"inlineContent":[{"text":"All lengths and offsets in a state use the same unit. Text viewports and modals use","type":"text"},{"text":" ","type":"text"},{"text":"display rows ","type":"text"},{"type":"strong","inlineContent":[{"text":"after wrapping at the final content width","type":"text"}]},{"text":". A selectable list uses","type":"text"},{"text":" ","type":"text"},{"text":"one row per item; it does not wrap items. A table uses one row per record, excluding","type":"text"},{"text":" ","type":"text"},{"text":"its fixed header. Declarative ","type":"text"},{"type":"codeVoice","code":"ScrollView"},{"text":" uses laid-out terminal rows, including","type":"text"},{"text":" ","type":"text"},{"text":"child spacing. Selection indices are not scroll positions.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Low-level components return layout metadata; their caller owns input policy.","type":"text"},{"text":" ","type":"text"},{"text":"Stateful text viewports and lists save normalized offsets when measured or drawn.","type":"text"},{"text":" ","type":"text"},{"text":"Stateless modals and tables expose a layout state that can be moved directly and","type":"text"},{"text":" ","type":"text"},{"text":"passed back as the next offset. Declarative ","type":"text"},{"type":"codeVoice","code":"ScrollView"},{"text":" retains its state internally","type":"text"},{"text":" ","type":"text"},{"text":"and reveals controls using the existing focus mechanism.","type":"text"}],"type":"paragraph"},{"text":"Layout and indicators","type":"heading","anchor":"Layout-and-indicators","level":2},{"inlineContent":[{"text":"First remove borders, titles, fixed headers, and padding from the available frame.","type":"text"},{"text":" ","type":"text"},{"text":"Then allocate the scrollbar gutter, lay out the content at the remaining width,","type":"text"},{"text":" ","type":"text"},{"text":"and resolve its scroll state. ","type":"text"},{"type":"codeVoice","code":"visibility: .whenNeeded"},{"text":" displays an indicator on the","type":"text"},{"text":" ","type":"text"},{"text":"first overflowing frame, independent of focus or input. ","type":"text"},{"type":"codeVoice","code":".hidden"},{"text":" suppresses it.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"gutter: .stable"},{"text":" reserves a column even when the indicator is hidden or unnecessary;","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".automatic"},{"text":" allocates it only while the indicator is needed and remeasures content","type":"text"},{"text":" ","type":"text"},{"text":"at the reduced width. No indicator overlaps the content.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The default is ","type":"text"},{"type":"codeVoice","code":".whenNeeded"},{"text":" with ","type":"text"},{"type":"codeVoice","code":".automatic"},{"text":". Use ","type":"text"},{"type":"codeVoice","code":".stable"},{"text":" when wrapping must","type":"text"},{"text":" ","type":"text"},{"text":"remain unchanged as content starts or stops overflowing. A track and thumb show","type":"text"},{"text":" ","type":"text"},{"text":"position and viewport proportion; arrows indicate content before and after the","type":"text"},{"text":" ","type":"text"},{"text":"visible range. One- and two-row indicators retain the direction information.","type":"text"},{"text":" ","type":"text"},{"text":"Glyphs and ","type":"text"},{"type":"codeVoice","code":"TerminalStyle"},{"text":" values are configurable; meaning does not depend on color.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Negative lengths become zero. Empty content resolves to ","type":"text"},{"type":"codeVoice","code":"0..<0"},{"text":". Offsets are clamped","type":"text"},{"text":" ","type":"text"},{"text":"on initialization and on content\/viewport updates. A zero-length viewport has an","type":"text"},{"text":" ","type":"text"},{"text":"empty range, and page movement and range revelation do nothing. Content growth does","type":"text"},{"text":" ","type":"text"},{"text":"not automatically follow the end. Resizing and content shrinkage clamp the saved","type":"text"},{"text":" ","type":"text"},{"text":"offset before the next movement.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"These responsibilities follow the separation of content\/viewport units in","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/docs.rs\/ratatui\/latest\/ratatui\/widgets\/struct.ScrollbarState.html","type":"reference","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"overflow discovery in ","type":"text"},{"identifier":"https:\/\/textual.textualize.io\/guide\/widgets\/#scrolling","type":"reference","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and stable allocation in ","type":"text"},{"identifier":"https:\/\/textual.textualize.io\/styles\/scrollbar_gutter\/","type":"reference","isActive":true},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Public names and examples follow the emphasis on clarity at the call site in the","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/www.swift.org\/documentation\/api-design-guidelines\/#fundamentals","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Caller-owned text and list state","type":"heading","anchor":"Caller-owned-text-and-list-state","level":2},{"inlineContent":[{"text":"Measure or draw using the current frame before handling input. Drawing updates the","type":"text"},{"text":" ","type":"text"},{"text":"saved offset, and input remeasures against that frame so changed content cannot","type":"text"},{"text":" ","type":"text"},{"text":"leave a stale position behind. Pass ","type":"text"},{"type":"codeVoice","code":"in:"},{"text":" to input or movement when the size changes","type":"text"},{"text":" ","type":"text"},{"text":"before the next draw. Heights exclude borders, titles, padding, and fixed headers.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var text = TerminalTextViewport(","    lines: [\"A complete sentence.\", \"More content follows.\", \"日本語 and e\\u{301}.\"],","    scrollbar: TerminalScrollbar(gutter: .stable)",")","let size = TerminalSize(width: 24, height: 2)","let body = TerminalFrame(column: 0, line: 0, width: size.width, height: size.height)","var canvas = TerminalCanvas(size: size)","let layout = text.draw(on: &canvas, frame: body)","\/\/ layout.scroll.state and layout.visibleLines describe this exact drawing.","text.handle(.pageDown, in: body)","text.scroll(.end, in: body)","text.draw(on: &canvas, frame: body)","","var list = TerminalSelectableList(rows: (1 ... 20).map { \"Item \\($0)\" })","list.handle(.arrowDown, in: body) \/\/ changes selection and reveals it","list.scroll(.pages(1), in: body) \/\/ changes only the viewing position","list.revealSelection()           \/\/ explicitly returns to the selected item","list.draw(on: &canvas, frame: body)"]},{"inlineContent":[{"text":"List rows are single-line items, clipped horizontally; embedded newlines do not","type":"text"},{"text":" ","type":"text"},{"text":"create extra item rows. For custom multi-line items, lay them out first, map each","type":"text"},{"text":" ","type":"text"},{"text":"item to its display-row range, and call ","type":"text"},{"type":"codeVoice","code":"state.move(.reveal(itemRange))"},{"text":". This keeps","type":"text"},{"text":" ","type":"text"},{"text":"item identity and selection separate from the shared display-row coordinates.","type":"text"}],"type":"paragraph"},{"text":"Custom content and movement","type":"heading","anchor":"Custom-content-and-movement","level":2},{"inlineContent":[{"text":"The measuring closure receives the usable width. It may be called twice with an","type":"text"},{"text":" ","type":"text"},{"text":"automatic gutter. Slice the final laid-out content using the returned state, and","type":"text"},{"text":" ","type":"text"},{"text":"move a copy of that same state before saving its offset. The common calculation","type":"text"},{"text":" ","type":"text"},{"text":"does not assign keys, selection, focus, or a follow-the-end policy.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let scrollbar = TerminalScrollbar(gutter: .stable)","var offset = 999 \/\/ arbitrary caller-owned position; layout will normalize it","let frame = TerminalFrame(column: 0, line: 0, width: 20, height: 4)","var rows: [String] = []","let layout = scrollbar.layout(in: frame, offset: offset) { width in","    rows = TerminalTextLayout.wrap(\"A long paragraph. 日本語 and e\\u{301}.\", width: width).map(\\.text)","    return rows.count","}","var state = layout.state","offset = state.offset","var canvas = TerminalCanvas(size: TerminalSize(width: 20, height: 4))","for (line, index) in state.visibleRange.enumerated() {","    canvas.draw(rows[index], column: layout.contentFrame.column,","                line: layout.contentFrame.line + line, maxWidth: layout.contentFrame.width)","}","scrollbar.draw(on: &canvas, frame: layout.scrollbarFrame, state: state)","state.move(.pages(1)) \/\/ also .units(-1), .start, .end, .reveal(aRange)","offset = state.offset"]},{"inlineContent":[{"type":"codeVoice","code":"update(contentLength:viewportLength:)"},{"text":" reuses a retained state after new measurements.","type":"text"},{"text":" ","type":"text"},{"text":"Movement saturates safely even for extreme integer offsets or page counts.","type":"text"},{"text":" ","type":"text"},{"text":"Revealing an empty\/outside range does nothing; a range taller than the viewport","type":"text"},{"text":" ","type":"text"},{"text":"aligns its start, clamped to the last valid offset. A zero-width content frame has","type":"text"},{"text":" ","type":"text"},{"text":"a zero-length viewport and an empty visible range, even if it has positive height.","type":"text"},{"text":" ","type":"text"},{"text":"Custom scrollbar glyphs must occupy one display cell; wider or zero-width glyphs","type":"text"},{"text":" ","type":"text"},{"text":"are left blank to avoid writing outside the reserved column.","type":"text"}],"type":"paragraph"},{"text":"Modals, tables, and declarative views","type":"heading","anchor":"Modals-tables-and-declarative-views","level":2},{"inlineContent":[{"type":"codeVoice","code":"TerminalModal.layout(in:)"},{"text":" wraps inside borders, title rows, padding, and the","type":"text"},{"text":" ","type":"text"},{"text":"scrollbar gutter. Its ","type":"text"},{"type":"codeVoice","code":"scroll.state"},{"text":" supplies all range and movement information.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"modal.scroll(.pages(1), in: area)"},{"text":" measures, moves, and saves the next offset.","type":"text"},{"text":" ","type":"text"},{"text":"Reading a layout or drawing a modal remains stateless; it does not mutate the","type":"text"},{"text":" ","type":"text"},{"text":"modal’s requested offset. Use ","type":"text"},{"type":"codeVoice","code":"scroll(_:in:)"},{"text":", or copy\/move the returned state and","type":"text"},{"text":" ","type":"text"},{"text":"assign its offset, instead of incrementing an unnormalized requested offset.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"TerminalTable.layout(in:rowOffset:maxRows:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"draw"},{"text":" return the same shared","type":"text"},{"text":" ","type":"text"},{"text":"layout for the scrolling body. The header consumes one row and never scrolls.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"maxRows"},{"text":" further limits the actual body viewport. Selection highlighting is","type":"text"},{"text":" ","type":"text"},{"text":"independent of ","type":"text"},{"type":"codeVoice","code":"rowOffset"},{"text":"; reveal a selected record explicitly when that is the","type":"text"},{"text":" ","type":"text"},{"text":"desired policy:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let table = TerminalTable(","    columns: [TerminalTableColumn(header: \"Name\", width: 12)],","    rows: (1 ... 30).map { TerminalTableRow(cells: [TerminalTableCell(\"Item \\($0)\")]) },","    scrollbar: TerminalScrollbar(gutter: .stable)",")","let frame = TerminalFrame(column: 0, line: 0, width: 20, height: 8)","var canvas = TerminalCanvas(size: TerminalSize(width: 20, height: 8))","var state = table.draw(on: &canvas, frame: frame, rowOffset: 999).state","state.move(.pages(-1)) \/\/ seven body rows, excluding the fixed header","table.draw(on: &canvas, frame: frame, rowOffset: state.offset)"]},{"inlineContent":[{"text":"Declarative views need no externally stored offset:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["ScrollView(scrollbar: TerminalScrollbar(gutter: .stable)) {","    ForEach(1 ... 40, id: \\.self) { index in","        Button(\"Item \\(index)\") { \/* application action *\/ }","    }","}"]},{"inlineContent":[{"text":"It displays overflow before focus changes, clips children to the content frame, and","type":"text"},{"text":" ","type":"text"},{"text":"uses the shared range-revelation calculation when the existing focus mechanism","type":"text"},{"text":" ","type":"text"},{"text":"selects a control. Content without selectable controls still gets an indicator;","type":"text"},{"text":" ","type":"text"},{"text":"the existing declarative input mechanism only scrolls through focusable controls.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ScrollView"},{"text":" measures child layout at the final width; it does not change a child’s","type":"text"},{"text":" ","type":"text"},{"text":"own layout policy (for example, declarative ","type":"text"},{"type":"codeVoice","code":"Text"},{"text":" remains single-line).","type":"text"}],"type":"paragraph"},{"text":"Migrating from 0.2.0 to 0.3.0","type":"heading","anchor":"Migrating-from-020-to-030","level":2},{"inlineContent":[{"text":"Set the package dependency to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".package(url: \"https:\/\/github.com\/uchimanajet7\/keel-tui\", from: \"0.3.0\")"},{"text":" ","type":"text"},{"text":"to use the APIs described in this guide.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"TerminalTextViewport.visibleLines(height:)","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"TerminalSelectableList.visibleRows(height:)","type":"codeVoice"},{"type":"text","text":", and"},{"type":"text","text":" "},{"code":"normalizedScrollOffset(height:)","type":"codeVoice"},{"type":"text","text":" now mutate the retained offset. Declare these"},{"type":"text","text":" "},{"type":"text","text":"component values with "},{"code":"var","type":"codeVoice"},{"type":"text","text":", and make enclosing rendering methods "},{"code":"mutating","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"when they own those values."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The height-only text API treats supplied lines as already laid-out display rows."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"code":"layout(in:)","type":"codeVoice"},{"type":"text","text":" or "},{"code":"draw(on:frame:)","type":"codeVoice"},{"type":"text","text":" to wrap at the final width with a gutter."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Key handlers use the last measured viewport; page movement is zero until a"},{"type":"text","text":" "},{"type":"text","text":"viewport is measured. Pass the current frame to "},{"code":"handle(_:in:)","type":"codeVoice"},{"type":"text","text":" for immediate"},{"type":"text","text":" "},{"type":"text","text":"input handling. Fixed ten-row paging is removed."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"List slicing no longer continually snaps the viewport to selection. Selection"},{"type":"text","text":" "},{"type":"text","text":"movement reveals the selected item; browsing does not. After directly setting"},{"type":"text","text":" "},{"code":"selectedIndex","type":"codeVoice"},{"type":"text","text":", call "},{"code":"revealSelection()","type":"codeVoice"},{"type":"text","text":" if needed."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Text\/list drawing, modals, tables, and declarative scroll views show an automatic scrollbar by"},{"type":"text","text":" "},{"type":"text","text":"default. To disable it explicitly, pass "},{"code":"TerminalScrollbar(visibility: .hidden)","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Choose "},{"code":".stable","type":"codeVoice"},{"type":"text","text":" to reserve width even without visible overflow."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"TerminalModalLayout","type":"codeVoice"},{"type":"text","text":" metadata is read-only and derived from "},{"code":"scroll","type":"codeVoice"},{"type":"text","text":". Its"},{"type":"text","text":" "},{"type":"text","text":"initializer now accepts "},{"code":"frame","type":"codeVoice"},{"type":"text","text":", "},{"code":"scroll","type":"codeVoice"},{"type":"text","text":", "},{"code":"wrappedLines","type":"codeVoice"},{"type":"text","text":", and "},{"code":"naturalHeight","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"replacing independently writable, potentially inconsistent range fields."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"A table’s out-of-range "},{"code":"rowOffset","type":"codeVoice"},{"type":"text","text":" now clamps to the final viewport. "},{"code":"draw","type":"codeVoice"},{"type":"text","text":" returns"},{"type":"text","text":" "},{"type":"text","text":"a discardable "},{"code":"TerminalScrollLayout","type":"codeVoice"},{"type":"text","text":"; use its state for the next movement."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Run the generic ","type":"text"},{"identifier":"https:\/\/github.com\/uchimanajet7\/keel-tui\/tree\/0.3.0\/Examples\/Scrolling","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"type":"codeVoice","code":"swift run"},{"text":" from its directory. Its README describes","type":"text"},{"text":" ","type":"text"},{"text":"keys and expected first-frame, endpoint, selection, and resize behavior. Run","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"swift test"},{"text":" at the repository root for automated verification. Terminal-emulator","type":"text"},{"text":" ","type":"text"},{"text":"visual inspection is a separate check.","type":"text"}],"type":"paragraph"}]}],"metadata":{"title":"Consistent scrolling","role":"article","roleHeading":"Article","modules":[{"name":"KeelTUI"}]},"references":{"doc://KeelTUI/documentation/KeelTUI/TerminalDisplayWidth":{"title":"TerminalDisplayWidth","url":"\/documentation\/keeltui\/terminaldisplaywidth","type":"topic","role":"symbol","abstract":[],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TerminalDisplayWidth","kind":"identifier"}],"navigatorTitle":[{"text":"TerminalDisplayWidth","kind":"identifier"}],"identifier":"doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalDisplayWidth","kind":"symbol"},"https://www.swift.org/documentation/api-design-guidelines/#fundamentals":{"identifier":"https:\/\/www.swift.org\/documentation\/api-design-guidelines\/#fundamentals","title":"Swift API Design Guidelines","type":"link","titleInlineContent":[{"text":"Swift API Design Guidelines","type":"text"}],"url":"https:\/\/www.swift.org\/documentation\/api-design-guidelines\/#fundamentals"},"doc://KeelTUI/documentation/KeelTUI/TerminalScrollMovement":{"title":"TerminalScrollMovement","url":"\/documentation\/keeltui\/terminalscrollmovement","type":"topic","role":"symbol","abstract":[{"text":"An input-independent movement in the same units as a scroll state.","type":"text"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TerminalScrollMovement","kind":"identifier"}],"navigatorTitle":[{"text":"TerminalScrollMovement","kind":"identifier"}],"identifier":"doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalScrollMovement","kind":"symbol"},"https://github.com/uchimanajet7/keel-tui/tree/0.3.0/Examples/Scrolling":{"identifier":"https:\/\/github.com\/uchimanajet7\/keel-tui\/tree\/0.3.0\/Examples\/Scrolling","title":"Scrolling example","type":"link","titleInlineContent":[{"text":"Scrolling example","type":"text"}],"url":"https:\/\/github.com\/uchimanajet7\/keel-tui\/tree\/0.3.0\/Examples\/Scrolling"},"https://textual.textualize.io/guide/widgets/#scrolling":{"identifier":"https:\/\/textual.textualize.io\/guide\/widgets\/#scrolling","title":"Textual scrolling","type":"link","titleInlineContent":[{"text":"Textual scrolling","type":"text"}],"url":"https:\/\/textual.textualize.io\/guide\/widgets\/#scrolling"},"doc://KeelTUI/documentation/KeelTUI/TerminalScrollbarGutter":{"title":"TerminalScrollbarGutter","url":"\/documentation\/keeltui\/terminalscrollbargutter","type":"topic","role":"symbol","abstract":[{"text":"How the content and scrollbar share the available width.","type":"text"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TerminalScrollbarGutter","kind":"identifier"}],"navigatorTitle":[{"text":"TerminalScrollbarGutter","kind":"identifier"}],"identifier":"doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalScrollbarGutter","kind":"symbol"},"doc://KeelTUI/documentation/KeelTUI/TerminalTextViewportLayout":{"title":"TerminalTextViewportLayout","url":"\/documentation\/keeltui\/terminaltextviewportlayout","type":"topic","role":"symbol","abstract":[{"text":"Wrapped text and the shared layout used to slice and draw it.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TerminalTextViewportLayout","kind":"identifier"}],"navigatorTitle":[{"text":"TerminalTextViewportLayout","kind":"identifier"}],"identifier":"doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalTextViewportLayout","kind":"symbol"},"doc://KeelTUI/documentation/KeelTUI/TerminalTable":{"abstract":[],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TerminalTable"}],"navigatorTitle":[{"kind":"identifier","text":"TerminalTable"}],"title":"TerminalTable","kind":"symbol","identifier":"doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalTable","role":"symbol","url":"\/documentation\/keeltui\/terminaltable"},"doc://KeelTUI/documentation/KeelTUI":{"type":"topic","url":"\/documentation\/keeltui","title":"KeelTUI","identifier":"doc:\/\/KeelTUI\/documentation\/KeelTUI","abstract":[{"text":"A general-purpose terminal user interface toolkit for Swift applications on macOS 26 and later.","type":"text"}],"role":"collection","kind":"symbol"},"https://textual.textualize.io/styles/scrollbar_gutter/":{"identifier":"https:\/\/textual.textualize.io\/styles\/scrollbar_gutter\/","title":"Textual scrollbar-gutter","type":"link","titleInlineContent":[{"text":"Textual scrollbar-gutter","type":"text"}],"url":"https:\/\/textual.textualize.io\/styles\/scrollbar_gutter\/"},"doc://KeelTUI/documentation/KeelTUI/TerminalScrollbarGeometry":{"title":"TerminalScrollbarGeometry","url":"\/documentation\/keeltui\/terminalscrollbargeometry","type":"topic","role":"symbol","abstract":[{"text":"Track and thumb row ranges relative to a 