{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Units-and-ownership","level":2,"text":"Units and ownership"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All lengths and offsets in a state use the same unit. Text viewports and modals use"},{"type":"text","text":" "},{"type":"text","text":"display rows "},{"type":"strong","inlineContent":[{"type":"text","text":"after wrapping at the final content width"}]},{"type":"text","text":". A selectable list uses"},{"type":"text","text":" "},{"type":"text","text":"one row per item; it does not wrap items. A table uses one row per record, excluding"},{"type":"text","text":" "},{"type":"text","text":"its fixed header. Declarative "},{"type":"codeVoice","code":"ScrollView"},{"type":"text","text":" uses laid-out terminal rows, including"},{"type":"text","text":" "},{"type":"text","text":"child spacing. Selection indices are not scroll positions."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Low-level components return layout metadata; their caller owns input policy."},{"type":"text","text":" "},{"type":"text","text":"Stateful text viewports and lists save normalized offsets when measured or drawn."},{"type":"text","text":" "},{"type":"text","text":"Stateless modals and tables expose a layout state that can be moved directly and"},{"type":"text","text":" "},{"type":"text","text":"passed back as the next offset. Declarative "},{"type":"codeVoice","code":"ScrollView"},{"type":"text","text":" retains its state internally"},{"type":"text","text":" "},{"type":"text","text":"and reveals controls using the existing focus mechanism."}]},{"type":"heading","anchor":"Layout-and-indicators","level":2,"text":"Layout and indicators"},{"type":"paragraph","inlineContent":[{"type":"text","text":"First remove borders, titles, fixed headers, and padding from the available frame."},{"type":"text","text":" "},{"type":"text","text":"Then resolve three disjoint regions in order: "},{"type":"strong","inlineContent":[{"type":"text","text":"content → spacing → scrollbar"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Measure and wrap at the final "},{"type":"codeVoice","code":"contentFrame.width"},{"type":"text","text":", then resolve the scroll state"},{"type":"text","text":" "},{"type":"text","text":"from those rows and the content viewport. "},{"type":"codeVoice","code":"TerminalScrollLayout"},{"type":"text","text":" exposes read-only"},{"type":"text","text":" "},{"type":"codeVoice","code":"contentFrame"},{"type":"text","text":", "},{"type":"codeVoice","code":"spacingFrame"},{"type":"text","text":", and "},{"type":"codeVoice","code":"scrollbarFrame"},{"type":"text","text":" values for measurement, clipping,"},{"type":"text","text":" "},{"type":"text","text":"and drawing without duplicating width or coordinate calculations."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The three independent settings are:"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Setting"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Meaning"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"visibility"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".whenNeeded"},{"type":"text","text":" draws overflow immediately, independently of focus; "},{"type":"codeVoice","code":".hidden"},{"type":"text","text":" suppresses the indicator."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"gutter"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".stable"},{"type":"text","text":" always reserves the bar and spacing, even for empty\/fitting content or hidden visibility. "},{"type":"codeVoice","code":".automatic"},{"type":"text","text":" reserves them only when a visible bar is needed."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"contentSpacing"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Integer display cells between content and the one-column bar, reserved only with the gutter. Defaults to "},{"type":"strong","inlineContent":[{"type":"text","text":"0"}]},{"type":"text","text":", preserving existing widths and wrapping."}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"With "},{"type":"codeVoice","code":".automatic"},{"type":"text","text":" and "},{"type":"codeVoice","code":".whenNeeded"},{"type":"text","text":", measure without reservation first. Only if"},{"type":"text","text":" "},{"type":"text","text":"those rows exceed the viewport, allocate both bar and spacing and measure again at"},{"type":"text","text":" "},{"type":"text","text":"the final content width. "},{"type":"codeVoice","code":".automatic"},{"type":"text","text":" with "},{"type":"codeVoice","code":".hidden"},{"type":"text","text":" reserves neither. With"},{"type":"text","text":" "},{"type":"codeVoice","code":".stable"},{"type":"text","text":", the content width stays the same for a given frame and configuration"},{"type":"text","text":" "},{"type":"text","text":"regardless of content length, focus, or indicator visibility."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The examples explicitly choose "},{"type":"codeVoice","code":"contentSpacing: 1"},{"type":"text","text":" to show separation. One cell is"},{"type":"text","text":" "},{"type":"text","text":"an optional choice, not a universal standard. Negative values act as zero, including"},{"type":"text","text":" "},{"type":"text","text":"after assignment. Large values are bounded before arithmetic can overflow. Spacing"},{"type":"text","text":" "},{"type":"text","text":"shrinks first to preserve one content cell when possible: a reserved bar in width"},{"type":"text","text":" "},{"type":"text","text":"2 uses content 1, spacing 0, bar 1; width 1 uses content 0, spacing 0, bar 1. Width"},{"type":"text","text":" "},{"type":"text","text":"0 or height 0 draws nothing. Wide and combining characters retain the existing"},{"type":"text","text":" "},{"type":"text","text":"grapheme and display-width behavior and are never split to fit a narrow frame."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default is "},{"type":"codeVoice","code":".whenNeeded"},{"type":"text","text":" with "},{"type":"codeVoice","code":".automatic"},{"type":"text","text":". Use "},{"type":"codeVoice","code":".stable"},{"type":"text","text":" when wrapping must"},{"type":"text","text":" "},{"type":"text","text":"remain unchanged as content starts or stops overflowing. A track and thumb show"},{"type":"text","text":" "},{"type":"text","text":"position and viewport proportion; arrows indicate content before and after the"},{"type":"text","text":" "},{"type":"text","text":"visible range. One- and two-row indicators retain the direction information."},{"type":"text","text":" "},{"type":"text","text":"Glyphs and "},{"type":"codeVoice","code":"TerminalStyle"},{"type":"text","text":" values are configurable; meaning does not depend on color."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Negative lengths become zero. Empty content resolves to "},{"type":"codeVoice","code":"0..<0"},{"type":"text","text":". Offsets are clamped"},{"type":"text","text":" "},{"type":"text","text":"on initialization and on content\/viewport updates. A zero-length viewport has an"},{"type":"text","text":" "},{"type":"text","text":"empty range, and page movement and range revelation do nothing. Content growth does"},{"type":"text","text":" "},{"type":"text","text":"not automatically follow the end. Resizing and content shrinkage clamp the saved"},{"type":"text","text":" "},{"type":"text","text":"offset before the next movement."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"These responsibilities follow the separation of content\/viewport units in"},{"type":"text","text":" "},{"identifier":"https:\/\/docs.rs\/ratatui\/latest\/ratatui\/widgets\/struct.ScrollbarState.html","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"overflow discovery in "},{"identifier":"https:\/\/textual.textualize.io\/guide\/widgets\/#scrolling","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and stable allocation in "},{"identifier":"https:\/\/textual.textualize.io\/styles\/scrollbar_gutter\/","type":"reference","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Public names and examples follow the emphasis on clarity at the call site in the"},{"type":"text","text":" "},{"identifier":"https:\/\/www.swift.org\/documentation\/api-design-guidelines\/#fundamentals","type":"reference","isActive":true},{"type":"text","text":"."}]},{"type":"heading","anchor":"Caller-owned-text-and-list-state","level":2,"text":"Caller-owned text and list state"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Measure or draw using the current frame before handling input. Drawing updates the"},{"type":"text","text":" "},{"type":"text","text":"saved offset, and input remeasures against that frame so changed content cannot"},{"type":"text","text":" "},{"type":"text","text":"leave a stale position behind. Pass "},{"type":"codeVoice","code":"in:"},{"type":"text","text":" to input or movement when the size changes"},{"type":"text","text":" "},{"type":"text","text":"before the next draw. Heights exclude borders, titles, padding, and fixed headers."}]},{"type":"codeListing","code":["var text = TerminalTextViewport(","    lines: [\"A complete sentence.\", \"More content follows.\", \"日本語 and e\\u{301}.\"],","    scrollbar: TerminalScrollbar(gutter: .stable, contentSpacing: 1)",")","let size = TerminalSize(width: 24, height: 2)","let body = TerminalFrame(column: 0, line: 0, width: size.width, height: size.height)","var canvas = TerminalCanvas(size: size)","let layout = text.draw(on: &canvas, frame: body)","\/\/ layout.scroll.state and layout.visibleLines describe this exact drawing.","text.handle(.pageDown, in: body)","text.scroll(.end, in: body)","text.draw(on: &canvas, frame: body)","","var list = TerminalSelectableList(","    rows: (1 ... 20).map { \"Item \\($0)\" },","    scrollbar: TerminalScrollbar(gutter: .stable, contentSpacing: 1)",")","list.handle(.arrowDown, in: body) \/\/ changes selection and reveals it","list.scroll(.pages(1), in: body) \/\/ changes only the viewing position","list.revealSelection()           \/\/ explicitly returns to the selected item","list.draw(on: &canvas, frame: body)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"List rows are single-line items, clipped horizontally; embedded newlines do not"},{"type":"text","text":" "},{"type":"text","text":"create extra item rows. For custom multi-line items, lay them out first, map each"},{"type":"text","text":" "},{"type":"text","text":"item to its display-row range, and call "},{"type":"codeVoice","code":"state.move(.reveal(itemRange))"},{"type":"text","text":". This keeps"},{"type":"text","text":" "},{"type":"text","text":"item identity and selection separate from the shared display-row coordinates."}]},{"type":"heading","anchor":"Custom-content-and-movement","level":2,"text":"Custom content and movement"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The measuring closure receives the usable width. It may be called twice with an"},{"type":"text","text":" "},{"type":"text","text":"automatic gutter. Slice the final laid-out content using the returned state, and"},{"type":"text","text":" "},{"type":"text","text":"move a copy of that same state before saving its offset. The common calculation"},{"type":"text","text":" "},{"type":"text","text":"does not assign keys, selection, focus, or a follow-the-end policy."}]},{"type":"codeListing","code":["let scrollbar = TerminalScrollbar(gutter: .stable, contentSpacing: 1)","var offset = 999 \/\/ arbitrary caller-owned position; layout will normalize it","let frame = TerminalFrame(column: 0, line: 0, width: 20, height: 4)","var rows: [String] = []","let layout = scrollbar.layout(in: frame, offset: offset) { width in","    rows = TerminalTextLayout.wrap(\"A long paragraph. 日本語 and e\\u{301}.\", width: width).map(\\.text)","    return rows.count","}","var state = layout.state","offset = state.offset","var canvas = TerminalCanvas(size: TerminalSize(width: 20, height: 4))","canvas.clear(frame: frame) \/\/ also clear content when reusing a canvas","for (line, index) in state.visibleRange.enumerated() {","    canvas.draw(rows[index], column: layout.contentFrame.column,","                line: layout.contentFrame.line + line, maxWidth: layout.contentFrame.width)","}","scrollbar.draw(on: &canvas, layout: layout) \/\/ clears spacing and draws\/clears the bar","state.move(.pages(1)) \/\/ also .units(-1), .start, .end, .reveal(aRange)","offset = state.offset"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The layout-based drawing path clears spacing with a normal background and no"},{"type":"text","text":" "},{"type":"text","text":"selection, inversion, or emphasis. For a custom surface, use"},{"type":"text","text":" "},{"type":"codeVoice","code":"canvas.clear(frame: frame, style: TerminalStyle(background: .blue))"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"scrollbar.draw(on: &canvas, layout: layout, background: .blue)"},{"type":"text","text":", and use that"},{"type":"text","text":" "},{"type":"text","text":"background for normal content too. Redraw the content on selection, size, settings,"},{"type":"text","text":" "},{"type":"text","text":"or content changes; regions released by an automatic gutter belong to content"},{"type":"text","text":" "},{"type":"text","text":"again. The built-in components clear their supplied frames on every draw. When a"},{"type":"text","text":" "},{"type":"text","text":"caller moves or shrinks an outer frame, it must repaint the area it previously"},{"type":"text","text":" "},{"type":"text","text":"owned; component drawing never owns the area outside its current frame."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"draw(on:frame:state:)"},{"type":"text","text":" retains its original bar-only meaning: it writes only in"},{"type":"text","text":" "},{"type":"text","text":"the supplied scrollbar column and does not clear adjacent spacing."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"update(contentLength:viewportLength:)"},{"type":"text","text":" reuses a retained state after new measurements."},{"type":"text","text":" "},{"type":"text","text":"Movement saturates safely even for extreme integer offsets or page counts."},{"type":"text","text":" "},{"type":"text","text":"Revealing an empty\/outside range does nothing; a range taller than the viewport"},{"type":"text","text":" "},{"type":"text","text":"aligns its start, clamped to the last valid offset. A zero-width content frame has"},{"type":"text","text":" "},{"type":"text","text":"a zero-length viewport and an empty visible range, even if it has positive height."},{"type":"text","text":" "},{"type":"text","text":"Custom scrollbar glyphs must occupy one display cell; wider or zero-width glyphs"},{"type":"text","text":" "},{"type":"text","text":"are left blank to avoid writing outside the reserved column."}]},{"type":"heading","anchor":"Modals-tables-and-declarative-views","level":2,"text":"Modals, tables, and declarative views"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TerminalModal.layout(in:)"},{"type":"text","text":" wraps inside borders, title rows, padding, and the"},{"type":"text","text":" "},{"type":"text","text":"scrollbar and spacing. Natural width includes the stable gutter’s reservation;"},{"type":"text","text":" "},{"type":"text","text":"preferred, minimum, maximum, and caller-area bounds still apply. An explicit frame"},{"type":"text","text":" "},{"type":"text","text":"is never enlarged for spacing. Automatic gutters also preserve the existing"},{"type":"text","text":" "},{"type":"text","text":"content-derived outer width: reservation is decided inside that chosen width and"},{"type":"text","text":" "},{"type":"text","text":"bounded body height, then wrapping and height are resolved again using"},{"type":"text","text":" "},{"type":"text","text":"the common layout. Measurement and drawing use the same final content width."},{"type":"text","text":" "},{"type":"text","text":"Its "},{"type":"codeVoice","code":"scroll.state"},{"type":"text","text":" supplies all range and movement information."},{"type":"text","text":" "},{"type":"codeVoice","code":"modal.scroll(.pages(1), in: area)"},{"type":"text","text":" measures, moves, and saves the next offset."},{"type":"text","text":" "},{"type":"text","text":"Reading a layout or drawing a modal remains stateless; it does not mutate the"},{"type":"text","text":" "},{"type":"text","text":"modal’s requested offset. Use "},{"type":"codeVoice","code":"scroll(_:in:)"},{"type":"text","text":", or copy\/move the returned state and"},{"type":"text","text":" "},{"type":"text","text":"assign its offset, instead of incrementing an unnormalized requested offset."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TerminalTable.layout(in:rowOffset:maxRows:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"draw"},{"type":"text","text":" return the same shared"},{"type":"text","text":" "},{"type":"text","text":"layout for the scrolling body. The header uses the same content width, consumes"},{"type":"text","text":" "},{"type":"text","text":"one row, and never scrolls."},{"type":"text","text":" "},{"type":"codeVoice","code":"maxRows"},{"type":"text","text":" further limits the actual body viewport. Selection highlighting is"},{"type":"text","text":" "},{"type":"text","text":"independent of "},{"type":"codeVoice","code":"rowOffset"},{"type":"text","text":"; reveal a selected record explicitly when that is the"},{"type":"text","text":" "},{"type":"text","text":"desired policy:"}]},{"type":"codeListing","code":["let table = TerminalTable(","    columns: [TerminalTableColumn(header: \"Name\", width: 12)],","    rows: (1 ... 30).map { TerminalTableRow(cells: [TerminalTableCell(\"Item \\($0)\")]) },","    scrollbar: TerminalScrollbar(gutter: .stable, contentSpacing: 1)",")","let frame = TerminalFrame(column: 0, line: 0, width: 20, height: 8)","var canvas = TerminalCanvas(size: TerminalSize(width: 20, height: 8))","var state = table.draw(on: &canvas, frame: frame, rowOffset: 999).state","state.move(.pages(-1)) \/\/ seven body rows, excluding the fixed header","table.draw(on: &canvas, frame: frame, rowOffset: state.offset)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declarative views need no externally stored offset:"}]},{"type":"codeListing","code":["ScrollView(scrollbar: TerminalScrollbar(gutter: .stable, contentSpacing: 1)) {","    ForEach(1 ... 40, id: \\.self) { index in","        Button(\"Item \\(index)\") { \/* application action *\/ }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It displays overflow before focus changes, clips children to the content frame, and"},{"type":"text","text":" "},{"type":"text","text":"uses the shared range-revelation calculation when the existing focus mechanism"},{"type":"text","text":" "},{"type":"text","text":"selects a control. Content without selectable controls still gets an indicator;"},{"type":"text","text":" "},{"type":"text","text":"the existing declarative input mechanism only scrolls through focusable controls."},{"type":"text","text":" "},{"type":"codeVoice","code":"ScrollView"},{"type":"text","text":" measures child layout at the final width; it does not change a child’s"},{"type":"text","text":" "},{"type":"text","text":"own layout policy (for example, declarative "},{"type":"codeVoice","code":"Text"},{"type":"text","text":" remains single-line)."},{"type":"text","text":" "},{"type":"text","text":"An enclosing "},{"type":"codeVoice","code":".background(...)"},{"type":"text","text":" also supplies the spacing background without"},{"type":"text","text":" "},{"type":"text","text":"inheriting a child’s selected or highlighted appearance. Canvas text viewports,"},{"type":"text","text":" "},{"type":"text","text":"lists, tables, and modals accept "},{"type":"codeVoice","code":"background:"},{"type":"text","text":" on "},{"type":"codeVoice","code":"draw"},{"type":"text","text":" for the normal surface."},{"type":"text","text":" "},{"type":"text","text":"It defaults to the terminal background, preserving existing rendering. Content,"},{"type":"text","text":" "},{"type":"text","text":"row, selection, and scrollbar styles can override it for their own cells without"},{"type":"text","text":" "},{"type":"text","text":"affecting spacing. For example, use "},{"type":"codeVoice","code":"list.draw(on: &canvas, frame: body, background: .blue)"},{"type":"text","text":" to fill its normal surface, including spacing, with blue."}]},{"type":"heading","anchor":"Migrating-from-020-to-030","level":2,"text":"Migrating from 0.2.0 to 0.3.0"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set the package dependency to"},{"type":"text","text":" "},{"type":"codeVoice","code":".package(url: \"https:\/\/github.com\/uchimanajet7\/keel-tui\", from: \"0.3.0\")"},{"type":"text","text":" "},{"type":"text","text":"for the 0.3.0 migration below. "},{"type":"codeVoice","code":"contentSpacing"},{"type":"text","text":", "},{"type":"codeVoice","code":"spacingFrame"},{"type":"text","text":", and layout-based"},{"type":"text","text":" "},{"type":"text","text":"scrollbar drawing are additions in this checkout, not in the 0.3.0 tag."}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TerminalTextViewport.visibleLines(height:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"TerminalSelectableList.visibleRows(height:)"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"normalizedScrollOffset(height:)"},{"type":"text","text":" now mutate the retained offset. Declare these"},{"type":"text","text":" "},{"type":"text","text":"component values with "},{"type":"codeVoice","code":"var"},{"type":"text","text":", and make enclosing rendering methods "},{"type":"codeVoice","code":"mutating"},{"type":"text","text":" "},{"type":"text","text":"when they own those values."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The height-only text API treats supplied lines as already laid-out display rows."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"type":"codeVoice","code":"layout(in:)"},{"type":"text","text":" or "},{"type":"codeVoice","code":"draw(on:frame:)"},{"type":"text","text":" to wrap at the final width with a gutter."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key handlers use the last measured viewport; page movement is zero until a"},{"type":"text","text":" "},{"type":"text","text":"viewport is measured. Pass the current frame to "},{"type":"codeVoice","code":"handle(_:in:)"},{"type":"text","text":" for immediate"},{"type":"text","text":" "},{"type":"text","text":"input handling. Fixed ten-row paging is removed."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"List slicing no longer continually snaps the viewport to selection. Selection"},{"type":"text","text":" "},{"type":"text","text":"movement reveals the selected item; browsing does not. After directly setting"},{"type":"text","text":" "},{"type":"codeVoice","code":"selectedIndex"},{"type":"text","text":", call "},{"type":"codeVoice","code":"revealSelection()"},{"type":"text","text":" if needed."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Text\/list drawing, modals, tables, and declarative scroll views show an automatic scrollbar by"},{"type":"text","text":" "},{"type":"text","text":"default. To disable it explicitly, pass "},{"type":"codeVoice","code":"TerminalScrollbar(visibility: .hidden)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Choose "},{"type":"codeVoice","code":".stable"},{"type":"text","text":" to reserve width even without visible overflow."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TerminalModalLayout"},{"type":"text","text":" metadata is read-only and derived from "},{"type":"codeVoice","code":"scroll"},{"type":"text","text":". Its"},{"type":"text","text":" "},{"type":"text","text":"initializer now accepts "},{"type":"codeVoice","code":"frame"},{"type":"text","text":", "},{"type":"codeVoice","code":"scroll"},{"type":"text","text":", "},{"type":"codeVoice","code":"wrappedLines"},{"type":"text","text":", and "},{"type":"codeVoice","code":"naturalHeight"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"replacing independently writable, potentially inconsistent range fields."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A table’s out-of-range "},{"type":"codeVoice","code":"rowOffset"},{"type":"text","text":" now clamps to the final viewport. "},{"type":"codeVoice","code":"draw"},{"type":"text","text":" returns"},{"type":"text","text":" "},{"type":"text","text":"a discardable "},{"type":"codeVoice","code":"TerminalScrollLayout"},{"type":"text","text":"; use its state for the next movement."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Run the generic Scrolling example in this checkout’s "},{"type":"codeVoice","code":"Examples\/Scrolling"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":"swift run"},{"type":"text","text":" from its directory. Its README describes"},{"type":"text","text":" "},{"type":"text","text":"keys to compare spacing 0\/1 in text, list, table, and modal displays, plus expected"},{"type":"text","text":" "},{"type":"text","text":"first-frame, endpoint, selection, and resize behavior. Run"},{"type":"text","text":" "},{"type":"codeVoice","code":"swift test"},{"type":"text","text":" at the repository root for automated verification. Terminal-emulator"},{"type":"text","text":" "},{"type":"text","text":"visual inspection is a separate check."}]}]}],"metadata":{"modules":[{"name":"KeelTUI"}],"roleHeading":"Article","role":"article","title":"Consistent scrolling"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/KeelTUI\/documentation\/KeelTUI\/Scrolling"},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalScrollState","doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalScrollMovement","doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalScrollLayout","doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalScrollbar","doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalScrollbarStyle","doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalScrollbarGeometry","doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalScrollbarVisibility","doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalScrollbarGutter","doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalTextViewport","doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalTextViewportLayout","doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalSelectableList","doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalTable","doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalCanvas","doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalDisplayWidth","doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalStatusBar"],"anchor":"Terminal-primitives","title":"Terminal primitives"}],"hierarchy":{"paths":[["doc:\/\/KeelTUI\/documentation\/KeelTUI"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"article","abstract":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"TerminalScrollState"},{"type":"text","text":" for one-dimensional range and movement calculations, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"TerminalScrollbar"},{"type":"text","text":" for a vertical indicator, its reserved column, and content spacing. The same"},{"type":"text","text":" "},{"type":"text","text":"normalized state drives content slicing, movement, and the indicator. Input routing,"},{"type":"text","text":" "},{"type":"text","text":"focus, selection, and following newly appended content remain application policies."}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/keeltui\/scrolling"]}],"references":{"doc://KeelTUI/documentation/KeelTUI/TerminalScrollbarStyle":{"navigatorTitle":[{"kind":"identifier","text":"TerminalScrollbarStyle"}],"title":"TerminalScrollbarStyle","identifier":"doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalScrollbarStyle","abstract":[{"type":"text","text":"One-cell glyphs and existing terminal styles for a vertical scrollbar."}],"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/keeltui\/terminalscrollbarstyle","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TerminalScrollbarStyle"}]},"https://www.swift.org/documentation/api-design-guidelines/#fundamentals":{"titleInlineContent":[{"type":"text","text":"Swift API Design Guidelines"}],"title":"Swift API Design Guidelines","identifier":"https:\/\/www.swift.org\/documentation\/api-design-guidelines\/#fundamentals","type":"link","url":"https:\/\/www.swift.org\/documentation\/api-design-guidelines\/#fundamentals"},"doc://KeelTUI/documentation/KeelTUI/TerminalCanvas":{"navigatorTitle":[{"kind":"identifier","text":"TerminalCanvas"}],"title":"TerminalCanvas","identifier":"doc:\/\/KeelTUI\/documentation\/KeelTUI\/TerminalCanvas","abstract":[],"role":"symbol","kind":"symbol","type":"t